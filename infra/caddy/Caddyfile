(app) {
	encode zstd gzip

	# Access log (JSON, rolled, 30 days) — the source for the /stats/ dashboard. Contains client IPs; keep the retention short.
	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 6
			roll_keep_for 720h
		}
		format json
	}

	@api path /api/* /healthz /readyz
	handle @api {
		reverse_proxy api:8000
	}

	# Static downloads (Android APK, promo video), uploaded to /opt/talaqqi/downloads on the host
	handle_path /downloads/* {
		root * /srv/downloads
		file_server
	}

	# Visit statistics (GoAccess report generated by infra/scripts/stats.sh), owner only
	handle_path /stats/* {
		basic_auth {
			{$STATS_USER:admin} {$STATS_HASH}
		}
		root * /srv/stats
		file_server
	}
	redir /stats /stats/ permanent

	handle {
		reverse_proxy web:3000
	}
}

{$DOMAIN:tallaqi.com}, www.{$DOMAIN:tallaqi.com} {
	import app
	header {
		Strict-Transport-Security "max-age=2592000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# Plain HTTP by IP (staging / before DNS points here)
http://{$SERVER_IP:67.205.146.18} {
	import app
}
