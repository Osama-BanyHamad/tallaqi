# Copy to .env for local development
DEBUG=true
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://talaqqi_app:talaqqi_dev@localhost:5432/talaqqi
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
DEFAULT_LANGUAGE=ar
CELERY_TASK_ALWAYS_EAGER=true

# Production (tallaqi.com)
# DEBUG=false
# ALLOWED_HOSTS=tallaqi.com,www.tallaqi.com,api.tallaqi.com
# CORS_ALLOWED_ORIGINS=https://tallaqi.com,https://www.tallaqi.com
# DOMAIN=tallaqi.com

# Optional AI assistant (YELLOW class: drafts for humans, never Quran text). Leave null to run without AI.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_ASR_MODEL=gpt-4o-mini-transcribe
